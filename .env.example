# Copy to .env before the first production deployment.
APP_PORT=8080
POSTGRES_DB=dcs
POSTGRES_USER=dcs
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# Bootstrap administrator. The UI forces a password change at first sign-in.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-temporary-admin-password
ADMIN_DISPLAY_NAME=DCS System Administrator

# Set true only when the application is served over HTTPS.
SECURE_COOKIES=false
# Behind one trusted reverse proxy, set 1. Otherwise keep 0.
TRUST_PROXY=0
SESSION_HOURS=12
MAX_BODY_MB=32
SEED_SAMPLE_DATA=true
